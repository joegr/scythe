{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "scythe.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "server",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173",
        "uv",
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "--app-dir",
        "../server",
        "main:app",
        "--port",
        "8081",
        "--reload",
        "--reload-dir",
        "../server"
      ],
      "port": 8081
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx vite build && npx vite preview --port 4173 --strictPort"
      ],
      "port": 4173
    }
  ]
}
